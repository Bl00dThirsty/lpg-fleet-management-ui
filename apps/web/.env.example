# Live backend (docker gateway). Set to 'fake' to use the in-browser
# mock adapter (no backend required).
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:18080/api/v1

# Optional auth key kept for future Clerk integration.
VITE_CLERK_PUBLISHABLE_KEY=

# Required to render the ArcGIS map locally and in production.
VITE_ARCGIS_API_KEY=
