# Set to 'fake' to use the in-browser mock adapter (no backend required).
# Without this, the app will try to connect to the API at VITE_API_BASE_URL.
VITE_API_MODE=fake

# Optional auth key kept for future Clerk integration.
VITE_CLERK_PUBLISHABLE_KEY=

# Required to render the ArcGIS map locally and in production.
VITE_ARCGIS_API_KEY=
