# Set to 'fake' to use the in-browser mock adapter (no backend required).
# Without this, the app will try to connect to the API at VITE_API_BASE_URL.
VITE_API_MODE=fake

# Optional auth key kept for future Clerk integration.
VITE_CLERK_PUBLISHABLE_KEY=

# Required for basemaps AND the ArcGIS Routing service (premium:user:networkanalysis).
# Enable routing access and authorize the application domains in the ArcGIS key settings.
VITE_ARCGIS_API_KEY=
