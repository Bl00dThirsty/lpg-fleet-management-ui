# Required to render the ArcGIS map locally and in production.
VITE_ARCGIS_API_KEY=

# Local development backend mode.
#   mock  -> local Express mock server at http://localhost:8787/api/v1 (run `pnpm mock` / `turbo run dev`)
#   fake  -> in-browser fixture data, no server (Vercel / static deploy)
#   dev | production -> real API at VITE_API_BASE_URL (default /api/v1, proxied in dev)
VITE_API_MODE=mock