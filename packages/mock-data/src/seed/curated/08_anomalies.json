{
  "metadata": {
    "schema_version": "6.2",
    "description": "CSPH GPL Traceability System — Anomalies and Anomaly Assignments seed data",
    "domain_context": "Cameroon LPG supply chain under CSPH subsidy-control framework. Anomalies fall into INVESTIGATION (suspected fraud / diversion / falsification) and TECHNICAL (device, GPS, sync, battery) categories. Each anomaly is assigned to one of five notification groups (TECHNICAL, INVESTIGATION, ADMIN, MARKETING, TRANSPORT) and resolved by an investigator or supervisor.",
    "anomaly_categories": {
      "INVESTIGATION": "Suspected fraud, diversion, siphonnage, falsification — requires field investigation, possible redressement escalation",
      "TECHNICAL": "Device, GPS, sync, Kafka, server, battery — handled by technical support team"
    },
    "anomaly_types": {
      "VOLUMEGAP": "Difference between declared volume and tracked volume > 2.5% tolerance",
      "DEVIATIONROUTE": "Vehicle GPS shows route deviation > 5km from planned tournee route",
      "CHECKPOINTMISSED": "Checkpoints skipped or visited out-of-sequence",
      "SCANOUTOFSEQUENCE": "RFID scans recorded in wrong order (IN before OUT, or duplicate)",
      "SIPHONNAGE": "Suspected gas siphoning — outbound-load minus inbound-return > expected shrinkage",
      "SUBSTITUTIONBOUTEILLES": "Cylinders scanned out differ from cylinders scanned in (substitution suspected)",
      "FALSIFICATIONPREUVES": "Photo evidence metadata inconsistent — timestamps, GPS, EXIF tampering",
      "FILLINGILLEGAL": "Loading detected at non-registered filling centre or off-hours",
      "DIVERSIONSUBSIDIES": "Deliveries to non-eligible industrial/export clients flagged as domestic",
      "PDAUNSYNCED": "PDA device offline > 30 minutes without sync",
      "BATTERYCRITICAL": "Device battery level <= 15%",
      "GPSFAILURE": "GPS tracker offline, jamming detected, or position not updating",
      "KAFKATIMEOUT": "Kafka message bus timeout — events queued but not ingested",
      "IOTDEGRADATION": "Multiple devices from same org reporting degraded performance",
      "SERVERUNAVAILABLE": "CSPH platform API server unavailable for > 5 minutes",
      "TOURNEEUNASSIGNEDTOOLONG": "Tournee in PLANNED state without assignment for > 12 hours",
      "TRANSPORTERNOACK": "Transporter has not acknowledged a tournee within 4 hours",
      "GPSREMOVED": "GPS device physically removed from vehicle (power loss + location jump)",
      "DEVICEOFFLINE": "Any device not seen on network for > 30 minutes"
    },
    "resolution_pattern": "Each anomaly links to an entity (MARKETEUR / TRANSPORTEUR / LIVREUR / SITE / TOURNEE / CLIENT / CLIENTSITE / VEHICLE), an evidence JSON document, and (when assigned) an anomaly_assignment record pointing at the responsible investigator.",
    "subsidy_impact": "Cameroon subsidizes ~1,524 FCFA per 12.5kg cylinder (CSPH Order 0327/MINCOMMERCE of 2018-04-17, fixed retail 6,500 FCFA). A typical 50kg domestic cylinder (which the platform also tracks) carries ~6,000 FCFA subsidy. VOLUMEGAP and SIPHONNAGE anomalies translate directly into lost subsidy.",
    "compliance_authority": "CSPH — Caisse de Stabilisation des Prix des Hydrocarbures, Yaoundé. Coordinates with MINCOMMERCE, MINEE, and DGSN (gendarmerie) for criminal referrals."
  },
