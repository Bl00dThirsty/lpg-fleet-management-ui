  "notifications": [
    {
      "id": "notif-001-anom001-sipho-sctm",
      "rule_id": "nr-001-sipho-critique",
      "anomaly_id": "anom-001-sipho-sctm-nov",
      "target_user_id": "user-0003-csph-supervisor",
      "target_group_id": "ng-002-csph-investigation",
      "channel": "EMAIL",
      "subject": "[CSPH-INV] Siphonnage suspecté — SCTM Bonabéri tour-001 (115 000 FCFA)",
