{
  "metadata": {
    "schema_version": "6.2",
    "description": "CSPH GPL Traceability System — Notification groups, members, rules, and notifications",
    "delivery_channels": {
      "EMAIL": "Default for all users; transactional via SMTP relay smtp.csph.cm",
      "SMS": "MTN Cameroun SMPP gateway smpp.mtn.cm:2775 — used for CRITICAL and CRITIQUEEXTREME",
      "PUSH": "Mobile app push via FCM (Firebase Cloud Messaging) for livreurs and field agents",
      "IN_APP": "Bell icon in the CSPH web portal — polled every 60s",
      "WEBHOOK": "Outbound JSON webhook for partner integrations (SCDP, MINEE, DGSN)"
    },
    "notification_group_types": {
      "TECHNICAL": "Routes device/GPS/Kafka/server/PDA anomalies to the technical support team",
      "INVESTIGATION": "Routes suspected-fraud anomalies (siphonnage, substitution, falsification) to CSPH investigation unit",
      "ADMIN": "Routes system-level events (login, role changes, settings updates) to CSPH administrators",
      "MARKETING": "Routes marketeer-specific events (declarations, redressements, dispatch) to the relevant marketeur's commercial team",
      "TRANSPORT": "Routes transporter-acknowledgement and tournee-routing issues to transporter dispatch teams"
    },
    "severity_routing_logic": "Severity (FAIBLE / MODERE / ELEVE / CRITIQUE / CRITIQUEEXTREME) + anomaly_type determine which group receives the notification. CRITIQUEEXTREME anomalies also send SMS and trigger the DGSN escalation webhook.",
    "sla_notes": "INVESTIGATION: 24h acknowledgement, 7d resolution target. TECHNICAL: 4h ack for ELEVE+, 24h for MODERE, 72h for FAIBLE. ADMIN/MARKETING/TRANSPORT: 8h ack for ELEVE+."
  },
