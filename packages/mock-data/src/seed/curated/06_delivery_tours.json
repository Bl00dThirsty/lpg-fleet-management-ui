      "INTERNAL": "Marketer's own livreur + vehicle (full control over the tournee)",
      "EXTERNAL": "Third-party transporter handles transport; marketeur books capacity"
    },
    "tournee_types": {
      "VRAC": "Bulk delivery — tanker truck fills from depot and delivers to client tank",
      "BOUTEILLES50KG": "Cylinder delivery — truck carries 50kg cylinder bundles to client"
    },
    "site_reference": "delivery_tours reference operational sites (sites table) as source, and client_sites (client_sites table) as destinations",
    "volume_note": "Volumes in canonical units: VRAC in TM (tonnes métriques), BOUTEILLES50KG in btl (individual 50 kg bottles). Never liters, never kg."
  },
