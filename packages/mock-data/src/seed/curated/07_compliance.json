  "metadata": {
    "description": "CSPH GPL Traceability System — Declarations, Reconciliations, Redressements, Risk Scores seed data",
    "compliance_note": "CSPH requires LPG marketers to submit monthly volume declarations. The platform reconciles declared volumes against tracked volumes from scan events. Gaps above the 2.5% tolerance trigger redressement (reimbursement) notices issued to the marketeer.",
    "subsidy_context": "The Cameroon government subsidizes LPG for domestic consumers. CSPH uses this traceability system to ensure marketers don't divert subsidized volumes to industrial clients or export markets.",
    "volume_unit": "Tonne metric (TM) for vrac and kg for bottled LPG. 1 TM = 1000 kg."
  },
