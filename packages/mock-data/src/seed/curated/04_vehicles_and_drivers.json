{
  "metadata": {
    "description": "CSPH GPL Traceability System — Vehicles and Drivers seed data",
    "license_plate_format": "Wikipedia: Vehicle registration plates of Cameroon — format AB1234V (region code + 4 digits + series suffix). Truck/cargo format: AB1234VH. Regional codes: AD=Adamawa, CE=Centre, EN=Extreme-Nord, ES=Est, LT=Littoral, NO=Nord, NW=Nord-Ouest, OU=Ouest, SU=Sud, SW=Sud-Ouest",
    "vehicle_types": {
      "VRAC": "Bulk LPG tanker — cylindrical tank on truck chassis, typically 18,000–24,000 litres",
      "BOUTEILLES50KG": "Cylinder delivery truck — carries 50kg LPG cylinder bundles, typically 64–120 cylinders"
    },
    "certificate_note": "All GPL transport vehicles require a ministerial transport certificate renewed annually. Certificate numbers follow the pattern CERT-{TYPE}-{YEAR}-{NUMBER}.",
    "driver_license_format": "Cameroon driver license number: YYYY-NNNNNN (year issued + unique 6-digit sequence)",
    "volume_note": "Volumes in canonical units: VRAC max_volume in TM (tonnes m?triques), never liters. Bouteilles in btl (individual 50 kg bottles)."
  },
